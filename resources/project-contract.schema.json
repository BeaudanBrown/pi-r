{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-r.dev/schemas/project-contract-v1.json",
  "title": "pi-r project contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "templateVersion",
    "policyVersion",
    "project",
    "dependencies",
    "constants",
    "functions",
    "targets"
  ],
  "properties": {
    "contractVersion": { "const": 1 },
    "templateVersion": { "const": "pi-r-template-v1" },
    "policyVersion": { "const": "pi-r-policy-v1" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "nixpkgs"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "nixpkgs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "repo", "rev", "narHash", "lastModified"],
          "properties": {
            "owner": { "type": "string", "minLength": 1 },
            "repo": { "type": "string", "minLength": 1 },
            "rev": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "narHash": { "type": "string", "pattern": "^sha256-" },
            "lastModified": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "constants": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/rName" },
      "additionalProperties": { "$ref": "#/$defs/constant" }
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "parameters"],
        "properties": {
          "name": { "$ref": "#/$defs/rName" },
          "parameters": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/rName" }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "function", "artifact", "arguments"],
        "properties": {
          "name": { "$ref": "#/$defs/rName" },
          "function": { "$ref": "#/$defs/rName" },
          "artifact": { "enum": ["table", "object", "file"] },
          "arguments": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/rName" },
            "additionalProperties": { "$ref": "#/$defs/argumentReference" }
          },
          "pattern": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "over"],
            "properties": {
              "kind": { "enum": ["map", "cross"] },
              "over": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/rName" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "rName": {
      "type": "string",
      "pattern": "^(?:[A-Za-z]|\\.(?!\\d))[A-Za-z0-9._]*$",
      "not": {
        "anyOf": [
          { "enum": ["if", "else", "repeat", "while", "function", "for", "in", "next", "break", "TRUE", "FALSE", "NULL", "Inf", "NaN", "NA", "NA_integer_", "NA_real_", "NA_complex_", "NA_character_", "..."] },
          { "pattern": "^\\.\\.[0-9]+$" }
        ]
      }
    },
    "argumentReference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target"],
          "properties": { "target": { "$ref": "#/$defs/rName" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["constant"],
          "properties": { "constant": { "$ref": "#/$defs/rName" } }
        }
      ]
    },
    "constant": {
      "type": ["string", "number", "boolean", "null"]
    }
  }
}
