{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-r.dev/schemas/project-contract-v1.json",
  "title": "pi-r project contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "templateVersion",
    "policyVersion",
    "project",
    "dependencies",
    "constants",
    "functions",
    "targets"
  ],
  "properties": {
    "contractVersion": { "const": 1 },
    "templateVersion": { "const": "pi-r-template-v1" },
    "policyVersion": { "const": "pi-r-policy-v1" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "nixpkgs"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "nixpkgs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "repo", "rev", "narHash", "lastModified"],
          "properties": {
            "owner": { "type": "string", "minLength": 1 },
            "repo": { "type": "string", "minLength": 1 },
            "rev": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "narHash": { "type": "string", "pattern": "^sha256-[A-Za-z0-9+/]{43}=$" },
            "lastModified": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "deliverables": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "path"],
        "properties": {
          "target": { "$ref": "#/$defs/rName" },
          "path": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
          }
        }
      }
    },
    "dependencyApprovals": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.]{0,99}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "domain", "rationale", "policyStatus"],
        "properties": {
          "scope": { "enum": ["project", "shared"] },
          "domain": { "type": "string", "minLength": 1, "maxLength": 100 },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "policyStatus": { "enum": ["required", "preferred", "allowed", "unregistered"] }
        }
      }
    },
    "constants": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/rName" },
      "additionalProperties": { "$ref": "#/$defs/constant" }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "parameters"],
        "properties": {
          "name": {
            "$ref": "#/$defs/rName",
            "description": "Approved Function name. The contract declares only its signature; locking creates a fail-closed body stub."
          },
          "parameters": {
            "type": "array",
            "uniqueItems": true,
            "description": "Required parameter names only. Function bodies are not part of a contract proposal.",
            "items": { "$ref": "#/$defs/rName" }
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "User-approved domain purpose for implementation. Required for new Design and Revision proposals; absent only in legacy locked contracts."
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true,
            "description": "User-approved behavioral requirements, including relevant missing-value, duplicate, coding, cohort, and output rules. Requirements contain no R body code.",
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "artifact", "arguments"],
        "properties": {
          "name": { "$ref": "#/$defs/rName" },
          "function": {
            "$ref": "#/$defs/rName",
            "description": "Approved Function called by an ordinary target. Package functions must be wrapped by an Approved Function. Omit for a Source File Target."
          },
          "artifact": { "enum": ["table", "object", "file"] },
          "arguments": {
            "type": "object",
            "description": "Binds every Approved Function input parameter exactly once to a target or constant. Empty for a Source File Target.",
            "propertyNames": { "$ref": "#/$defs/rName" },
            "additionalProperties": { "$ref": "#/$defs/argumentReference" }
          },
          "source": {
            "type": "object",
            "description": "Declares an existing read-only input file tracked with targets format=file. Source files do not call an Approved Function and are not generated outputs.",
            "additionalProperties": false,
            "required": ["constant"],
            "properties": {
              "constant": { "$ref": "#/$defs/rName" }
            }
          },
          "output": {
            "type": "object",
            "additionalProperties": false,
            "required": ["parameter", "constant"],
            "properties": {
              "parameter": { "$ref": "#/$defs/rName" },
              "constant": { "$ref": "#/$defs/rName" }
            }
          },
          "pattern": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "over"],
            "properties": {
              "kind": { "enum": ["map", "cross"] },
              "over": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/rName" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "rName": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^(?:[A-Za-z]|\\.(?!\\d))[A-Za-z0-9._]*$",
      "not": {
        "anyOf": [
          { "enum": ["if", "else", "repeat", "while", "function", "for", "in", "next", "break", "TRUE", "FALSE", "NULL", "Inf", "NaN", "NA", "NA_integer_", "NA_real_", "NA_complex_", "NA_character_", "..."] },
          { "pattern": "^\\.\\.[0-9]+$" }
        ]
      }
    },
    "argumentReference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target"],
          "properties": { "target": { "$ref": "#/$defs/rName" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["constant"],
          "properties": { "constant": { "$ref": "#/$defs/rName" } }
        }
      ]
    },
    "constant": {
      "type": ["string", "number", "boolean", "null"]
    }
  }
}
