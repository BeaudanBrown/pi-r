{
  "name": "pi-r",
  "version": "0.1.0",
  "private": true,
  "description": "Constrained, phase-gated R and targets workspace for Pi coding agents",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "bin": {
    "pi-r": "dist/cli.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-r.ts"
    ]
  },
  "scripts": {
    "build": "esbuild src/index.ts src/cli.ts --bundle --platform=node --format=esm --outdir=dist --out-extension:.js=.mjs",
    "typecheck": "tsc",
    "verify": "nix run .#verify"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  }
}
